# Application Configuration
NODE_ENV=development
PORT=5001
TRUST_PROXY_HOPS=0
SERVE_FRONTEND=false

# Authentication
AUTH_SECRET=replace-with-a-secure-random-32-character-secret-key

# Database (optional for local pg-mem development; required for deployment)
DATABASE_URL=
POSTGRES_PASSWORD=replace-with-a-local-only-postgres-password

# Cloud & Storage Integrations (Optional)
SUPABASE_URL=
SUPABASE_STORAGE_BUCKET=
GEMINI_API_KEY=

# Frontend
VITE_API_URL=/api
VITE_API_PROXY_TARGET=http://localhost:5001
